/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "Calcpace importuje běhy a procházky, které vaše Apple Watch a běžecké aplikace (Strava, Nike, Garmin, adidas) ukládají do aplikace Zdraví. Čteme jen čas, vzdálenost, trvání, stoupání, tepovou frekvenci a trasu těchto tréninků.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "Calcpace do aplikace Zdraví nic neukládá.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "Calcpace používá fotoaparát jen tehdy, když se rozhodnete vyfotit fotku k běhu nebo do profilu.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "Calcpace používá mikrofon jen tehdy, když se při přikládání souboru rozhodnete natočit video.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "Calcpace otevře vaše fotky jen tehdy, když nějakou vyberete k běhu nebo do profilu.";
