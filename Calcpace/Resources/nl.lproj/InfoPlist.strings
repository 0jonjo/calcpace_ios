/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "Calcpace importeert de runs en wandelingen die je Apple Watch en hardloopapps (Strava, Nike, Garmin, adidas) in de Gezondheid-app opslaan. We lezen alleen het tijdstip, de afstand, de duur, het hoogteverschil, de hartslag en de route van die trainingen.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "Calcpace slaat niets op in de Gezondheid-app.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "Calcpace gebruikt de camera alleen als je een foto of video wilt maken om toe te voegen, zoals de foto van een loop, je profielfoto of een bestand.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "Calcpace gebruikt de microfoon alleen als je een video wilt opnemen bij het toevoegen van een bestand.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "Calcpace opent je foto’s alleen als je er een kiest voor een loop of je profiel.";

/* "Save Image" in the share sheet of a run's card (ShareImageComponent): iOS ends an app that adds to the photos without this. */
"NSPhotoLibraryAddUsageDescription" = "Calcpace bewaart alleen een afbeelding in je foto’s als je bij het delen van een loop Bewaar afbeelding kiest.";
