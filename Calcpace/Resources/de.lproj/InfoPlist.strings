/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "Calcpace importiert die Läufe und Spaziergänge, die deine Apple Watch und deine Lauf-Apps (Strava, Nike, Garmin, adidas) in der Health App speichern. Wir lesen nur Uhrzeit, Distanz, Dauer, Anstieg, Herzfrequenz und Strecke dieser Trainings.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "Calcpace speichert nichts in der Health App.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "Calcpace nutzt die Kamera nur, wenn du ein Foto oder Video zum Anhängen aufnehmen möchtest, etwa das Foto eines Laufs, dein Profilbild oder eine Datei.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "Calcpace nutzt das Mikrofon nur, wenn du beim Anhängen einer Datei ein Video aufnehmen möchtest.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "Calcpace öffnet deine Fotos nur, wenn du eines für einen Lauf oder dein Profil auswählst.";

/* "Save Image" in the share sheet of a run's card (ShareImageComponent): iOS ends an app that adds to the photos without this. */
"NSPhotoLibraryAddUsageDescription" = "Calcpace speichert ein Bild nur dann in deinen Fotos, wenn du beim Teilen eines Laufs „Bild sichern“ wählst.";
