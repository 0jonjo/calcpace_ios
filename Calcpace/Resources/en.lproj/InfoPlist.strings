/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "Calcpace imports the runs and walks your Apple Watch and running apps (Strava, Nike, Garmin, adidas) save to the Health app. We read only the time, distance, duration, climb, heart rate and route of those workouts.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "Calcpace doesn't write anything to the Health app.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "Calcpace uses the camera only when you choose to take a photo or video to attach, such as a run's photo, your profile picture or a file.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "Calcpace uses the microphone only if you choose to film a video when attaching a file.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "Calcpace opens your photos only when you choose one for a run or for your profile.";

/* "Save Image" in the share sheet of a run's card (ShareImageComponent): iOS ends an app that adds to the photos without this. */
"NSPhotoLibraryAddUsageDescription" = "Calcpace saves an image to your photos only when you choose Save Image when sharing a run.";
