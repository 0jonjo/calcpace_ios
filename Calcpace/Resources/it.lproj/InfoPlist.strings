/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "Calcpace importa le corse e camminate che il tuo Apple Watch e le tue app di corsa (Strava, Nike, Garmin, adidas) salvano nell'app Salute. Leggiamo solo orario, distanza, durata, dislivello, frequenza cardiaca e percorso di quegli allenamenti.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "Calcpace non salva nulla nell'app Salute.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "Calcpace usa la fotocamera solo quando scegli di scattare una foto per una corsa o per il tuo profilo.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "Calcpace usa il microfono solo se scegli di girare un video allegando un file.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "Calcpace apre le tue foto solo quando ne scegli una per una corsa o per il tuo profilo.";
