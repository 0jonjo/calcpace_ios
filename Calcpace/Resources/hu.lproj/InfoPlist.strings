/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "A Calcpace azokat a futásokat és sétákat importálja, amelyeket az Apple Watch és a futóalkalmazásaid (Strava, Nike, Garmin, adidas) az Egészség appba mentenek. Ezekből az edzésekből csak az időpontot, a távot, az időtartamot, az emelkedést, a pulzust és az útvonalat olvassuk be.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "A Calcpace semmit sem ment az Egészség appba.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "A Calcpace csak akkor használja a kamerát, ha fotót szeretnél készíteni egy futáshoz vagy a profilodhoz.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "A Calcpace csak akkor használja a mikrofont, ha fájl csatolásakor videót szeretnél felvenni.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "A Calcpace csak akkor nyitja meg a fotóidat, ha kiválasztasz egyet egy futáshoz vagy a profilodhoz.";
