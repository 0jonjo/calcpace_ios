/* The Apple Health permission sheet: why the app reads workouts (calcpace_web apple_health.card.body, its first and last sentences). */
"NSHealthShareUsageDescription" = "Calcpace importuje biegi i spacery, które Twój Apple Watch i aplikacje do biegania (Strava, Nike, Garmin, adidas) zapisują w aplikacji Zdrowie. Odczytujemy tylko godzinę, dystans, czas trwania, przewyższenie, tętno i trasę z tych treningów.";

/* Required by App Store validation next to the read text, although the app only reads (HealthReader). */
"NSHealthUpdateUsageDescription" = "Calcpace niczego nie zapisuje w aplikacji Zdrowie.";

/* The web view's file fields ("Take Photo or Video"): iOS ends an app that opens the camera without this. */
"NSCameraUsageDescription" = "Calcpace używa aparatu tylko wtedy, gdy zdecydujesz się zrobić zdjęcie lub film do załączenia, np. zdjęcie biegu, zdjęcie profilowe lub plik.";

/* Filming a video from the same file fields. */
"NSMicrophoneUsageDescription" = "Calcpace używa mikrofonu tylko wtedy, gdy przy dołączaniu pliku zdecydujesz się nagrać film.";

/* Choosing a photo from the library in the same file fields. */
"NSPhotoLibraryUsageDescription" = "Calcpace otwiera Twoje zdjęcia tylko wtedy, gdy wybierzesz jedno do biegu lub profilu.";

/* "Save Image" in the share sheet of a run's card (ShareImageComponent): iOS ends an app that adds to the photos without this. */
"NSPhotoLibraryAddUsageDescription" = "Calcpace zapisuje obraz w Twoich zdjęciach tylko wtedy, gdy przy udostępnianiu biegu wybierzesz Zachowaj obraz.";
