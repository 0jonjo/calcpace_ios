# match keeps the App Store distribution certificate and profile encrypted
# (MATCH_PASSWORD) in the private repository calcpace_ios_certs, so CI can
# sign without a Mac or a keychain of its own.
#
# MATCH_GIT_URL: https://github.com/0jonjo/calcpace_ios_certs.git
# MATCH_GIT_BASIC_AUTHORIZATION: base64 of "user:token", a fine-grained token
# with Contents access to that repository only (match reads it from the
# environment by that name).
git_url(ENV["MATCH_GIT_URL"])
storage_mode("git")
git_branch("main")

type("appstore")
app_identifier(["app.calcpace.ios"])
team_id(ENV["APPLE_TEAM_ID"])

# Read only: CI installs what is in the repository and never creates or
# revokes anything. The one run that creates the certificate and profile
# (the TestFlight workflow, started by hand with "certs") sets
# CERTS_CREATE=true. Not MATCH_READONLY: setup_ci overwrites that one.
readonly(ENV["CERTS_CREATE"] != "true")
